# Statsopedia data-processor — copy to `.env` (same directory). Real environment variables take precedence.

DATA_PROCESSOR_HOST=127.0.0.1
DATA_PROCESSOR_PORT=8000
# debug | info | warning | error | critical
DATA_PROCESSOR_LOG_LEVEL=info
# Relative paths resolve against this service's working directory (services/data-processor).
DATA_PROCESSOR_STORAGE_ROOT=../../storage
# Largest CSV the processor reads, in bytes, and the most data rows it accepts.
DATA_PROCESSOR_MAX_CSV_BYTES=104857600
DATA_PROCESSOR_MAX_CSV_ROWS=1000000
