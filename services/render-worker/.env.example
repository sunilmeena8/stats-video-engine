# Statsopedia render worker — copy to `.env` (same directory). Real environment variables take precedence.

NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Must match REDIS_PASSWORD in the root .env used by Docker Compose.
REDIS_URL=redis://:change-me@127.0.0.1:6379
# Same database as the API: the worker records job progress, outputs and metadata itself.
DATABASE_URL=postgres://statsopedia:change-me@127.0.0.1:5432/statsopedia

# Relative paths resolve against this service's working directory (services/render-worker).
STORAGE_ROOT=../../storage
# Remotion entry point that is bundled once at start-up.
RENDERER_ENTRY_POINT=../../apps/renderer/src/index.ts

# Renders are CPU-heavy; keep this at 1 unless the machine has headroom.
RENDER_CONCURRENCY=1
# Concurrent preview renders (separate queue from final renders).
PREVIEW_CONCURRENCY=1

# Browser tabs rendering frames of one video in parallel; unset lets Remotion choose
# (half the CPU cores). Lower it if renders starve the machine.
# REMOTION_CONCURRENCY=4
# An attempt running longer than this is aborted and retried (RENDER_TIMEOUT).
RENDER_TIMEOUT_MINUTES=60
PREVIEW_TIMEOUT_MINUTES=15
# How long one frame may wait for fonts, images or audio.
FRAME_TIMEOUT_SECONDS=120
# ffmpeg/ffprobe directory; unset uses the binaries bundled with Remotion (recommended).
# FFMPEG_BINARIES_DIR=
# Identifies this worker in logs and render metadata (default hostname:pid).
# WORKER_ID=
# Job working directories older than this are removed at start-up.
TEMP_RETENTION_HOURS=24
# A crashed worker's jobs are picked up by another worker after about
# LOCK_DURATION_SECONDS + STALLED_INTERVAL_SECONDS.
LOCK_DURATION_SECONDS=60
STALLED_INTERVAL_SECONDS=30
