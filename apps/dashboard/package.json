    "@statsopedia/ui": "workspace:*",
    "@statsopedia/utils": "workspace:*",
    "@statsopedia/video-config": "workspace:*",
    "@tanstack/react-query": "^5.107.1",
    "lucide-react": "^1.70.0",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "remotion": "catalog:",
    "server-only": "0.0.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
