{
  "name": "@statsopedia/dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Statsopedia operator dashboard (Next.js App Router).",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
