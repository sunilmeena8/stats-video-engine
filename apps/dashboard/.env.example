# Statsopedia dashboard — copy to `.env.local` (same directory).
# These are read on the server only (no NEXT_PUBLIC_ prefix), so they never reach the browser.

# The browser never calls these directly: the dashboard server proxies /api/backend/* to the API
# with the signed-in user's session, so the API can stay on a private address.
API_BASE_URL=http://127.0.0.1:4000
DATA_PROCESSOR_BASE_URL=http://127.0.0.1:8000
# Timeout for each service health probe on the settings page.
HEALTH_PROBE_TIMEOUT_MS=2500
# Session cookie over HTTPS only (default: on in production, off in development).
# SESSION_COOKIE_SECURE=true
