# Statsopedia API — copy to `.env` (same directory). Real environment variables take precedence.

NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Must match the credentials in the root .env used by Docker Compose.
DATABASE_URL=postgres://statsopedia:change-me@127.0.0.1:5432/statsopedia
REDIS_URL=redis://:change-me@127.0.0.1:6379

# Relative paths resolve against this service's working directory (apps/api).
STORAGE_ROOT=../../storage

# Per-dependency timeout for GET /health/ready.
HEALTH_CHECK_TIMEOUT_MS=2000

# Data-processor (internal service) and dataset upload limits.
DATA_PROCESSOR_URL=http://127.0.0.1:8000
DATA_PROCESSOR_TIMEOUT_MS=120000
# Largest CSV upload, in bytes (50 MB).
MAX_UPLOAD_BYTES=52428800

# Media uploads (music, logos, images), in bytes (25 MB).
MAX_MEDIA_BYTES=26214400
# Login sessions expire after this many hours.
SESSION_TTL_HOURS=12
# Per-user request and upload rate limits (in-memory, per API instance).
RATE_LIMIT_PER_MINUTE=600
UPLOADS_PER_HOUR=120
# Exactly one API instance should run the render job monitor.
JOB_MONITOR_ENABLED=true

# Seed (pnpm --filter @statsopedia/api db:seed): the first admin account. No defaults.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=<at least 12 characters>
# Optional second account with the editor role (people sign in to the dashboard with their own).
# SEED_DASHBOARD_EMAIL=dashboard@example.com
# SEED_DASHBOARD_PASSWORD=<at least 12 characters>
