# ── Dependencies ────────────────────────────────────────────────
node_modules/
.pnpm-store/

# ── Build output ────────────────────────────────────────────────
dist/
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts

# ── Test / coverage ─────────────────────────────────────────────
coverage/
.vitest/

# ── Python ──────────────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Secrets & environment (keep the .env.example templates) ────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
credentials*.json
service-account*.json

# ── Generated media anywhere in the repo ────────────────────────
*.mp4
*.mov
*.mkv
*.webm
*.m4v
*.avi
*.gif
remotion-out/

# ── Temporary files & logs ──────────────────────────────────────
tmp/
temp/
*.tmp
*.log
npm-debug.log*
pnpm-debug.log*

# ── OS / editor ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ── Storage: keep the directory skeleton, ignore every file in it.
# Must stay LAST so these re-include rules win over earlier patterns (e.g. temp/).
/storage/**
!/storage/**/
!/storage/**/.gitkeep

# Generated by `pnpm --filter @statsopedia/renderer sample:music` (do not commit audio).
apps/renderer/public/audio/
