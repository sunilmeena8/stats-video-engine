# ─────────────────────────────────────────────────────────────────
# Root environment — read by Docker Compose (compose.yaml) only.
# Copy to `.env` and replace every `change-me` value. Never commit `.env`.
# Each service has its own `.env.example` next to its source code.
# ─────────────────────────────────────────────────────────────────

# PostgreSQL (metadata store)
POSTGRES_USER=statsopedia
POSTGRES_PASSWORD=change-me
POSTGRES_DB=statsopedia
POSTGRES_PORT=5432

# Redis (BullMQ job queue)
REDIS_PASSWORD=change-me
REDIS_PORT=6379
