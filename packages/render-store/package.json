{
  "name": "@statsopedia/render-store",
  "version": "0.1.0",
  "private": true,
  "description": "PostgreSQL persistence of render requests, jobs, logs and outputs, shared by the API and the render worker.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@statsopedia/shared-schemas": "workspace:*",
    "@statsopedia/shared-types": "workspace:*",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.15.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
