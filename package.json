{
  "name": "statsopedia",
  "version": "0.1.0",
  "private": true,
  "description": "Semi-automated YouTube video generation platform for historical statistics, global rankings and data visualization.",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.16.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter \"./packages/**\" --filter @statsopedia/render-worker build",
    "clean": "pnpm -r clean",
    "dev:api": "pnpm --filter @statsopedia/api dev",
    "dev:dashboard": "pnpm --filter @statsopedia/dashboard dev",
    "dev:renderer": "pnpm --filter @statsopedia/renderer dev",
    "dev:worker": "pnpm --filter @statsopedia/render-worker dev",
    "dev:data-processor": "pnpm --filter @statsopedia/data-processor dev",
    "setup:python": "pnpm --filter @statsopedia/data-processor run bootstrap",
    "render:sample": "pnpm --filter @statsopedia/renderer render:sample",
    "render:sample:short": "pnpm --filter @statsopedia/renderer render:sample:short",
    "lint": "eslint . && pnpm --filter @statsopedia/data-processor lint",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "test": "pnpm build:packages && pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "infra:config": "docker compose config --quiet"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@next/eslint-plugin-next": "catalog:",
    "@remotion/eslint-plugin": "catalog:",
    "eslint": "^10.0.0",
    "eslint-config-next": "catalog:",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.0",
    "globals": "^17.0.0",
    "prettier": "^3.6.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.56.0"
  }
}
